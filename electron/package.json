{
  "name": "bytetv",
  "productName": "Byte TV",
  "version": "1.1.0",
  "description": "Byte TV 桌面客户端（Electron 壳 + Go 后端子进程）",
  "main": "main.js",
  "private": true,
  "scripts": {
    "build:frontend": "npm --prefix ../frontend ci && npm --prefix ../frontend run build",
    "build:backend": "node scripts/build-backend.js",
    "start": "electron .",
    "dev": "JUKU_DEV=1 electron .",
    "dist:mac": "npm run build:frontend && node scripts/build-backend.js darwin && electron-builder --mac --universal",
    "dist:win": "npm run build:frontend && node scripts/build-backend.js windows && electron-builder --win --x64",
    "check": "node --check main.js && node --check preload.js && node --check backend.js && node --check scripts/build-backend.js"
  },
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^33.2.1",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bytetv.app",
    "productName": "Byte TV",
    "artifactName": "ByteTV-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "backend.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../frontend/dist",
        "to": "ui"
      },
      {
        "from": "resources/bin/${os}",
        "to": "bin"
      }
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.entertainment",
      "target": [
        {
          "target": "dmg"
        },
        {
          "target": "zip"
        }
      ],
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "build/entitlements.mac.plist",
      "entitlementsInherit": "build/entitlements.mac.plist",
      "binaries": [
        "Contents/Resources/bin/juku-backend"
      ],
      "notarize": true,
      "x64ArchFiles": "Contents/Resources/bin/juku-backend"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "publish": [
      {
        "provider": "generic",
        "url": "https://example.invalid/juku/updates"
      }
    ]
  }
}
